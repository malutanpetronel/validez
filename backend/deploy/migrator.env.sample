# /etc/validez-be/migrator.env — doar pe server, root:root 0600, NU montat in PHP runtime.
# Folosit numai de containerul temporar `migrate` (docker-compose run --rm migrate).
# Parola: cea setata cu \password validez_migrator; caracterele speciale se codifica in URL (%40 pentru @ etc.).
DATABASE_URL="postgresql://validez_migrator:schimba-aici@db:5432/validez?serverVersion=16&charset=utf8"
