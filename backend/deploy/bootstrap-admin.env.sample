# /etc/validez-be/bootstrap-admin.env — DOAR pentru prima tranzitie (deploy cu -e validez_db_bootstrap=true),
# root:root 0600. Migrarile ruleaza o singura data cu utilizatorul de bootstrap, inainte sa existe validez_migrator.
# Se STERGE dupa bootstrap: deployul normal refuza sa ruleze cat timp fisierul exista.
# DB_USER si DB_PASSWORD din /etc/validez-be/compose.env, cu parola codificata in URL.
DATABASE_URL="postgresql://validez:schimba-aici@db:5432/validez?serverVersion=16&charset=utf8"
