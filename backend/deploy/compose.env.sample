# /etc/validez-be/compose.env — doar pe server, root:root 0600, NU in release si NU montat in containere.
# Citit de docker-compose cu --env-file (playbook si comenzile manuale din Deploy.md).
COMPOSE_PROJECT_NAME=validez_be
VIRTUAL_HOST=validez-be.webnou.ro
DB_CONTAINER=validez_be_db
PHP_CONTAINER=validez_be_php
NGINX_CONTAINER=validez_be_nginx
# Linia afisata de ./docker-build-push.sh (rulat local in validez/backend).
DOCKER_IMAGE=schimba-aici

# Utilizatorul de bootstrap al containerului PostgreSQL (POSTGRES_USER). Ramane administrativ:
# nu se schimba pe un volum existent si nu se foloseste de PHP sau de migrari.
DB_NAME=validez
DB_USER=validez
DB_PASSWORD=schimba-aici

# Credentialele migratorului; fisier separat, root:root 0600.
MIGRATOR_ENV_FILE=/etc/validez-be/migrator.env
# .env-ul runtime montat in PHP (symlink-ul ansistrano din release).
RUNTIME_ENV_FILE=./.env
