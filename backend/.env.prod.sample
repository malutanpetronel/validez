# Pe server: /var/www/validez-be/shared/backend/.env (symlink ansistrano langa docker-compose.prod.yml),
# root:1000 0640. E montat peste backend/.env in containerul PHP, deci inlocuieste complet valorile implicite:
# toate cheile Symfony trebuie sa fie aici.
#
# DOAR configurarea runtime. Variabilele docker-compose (DOCKER_IMAGE, containere, DB_PASSWORD de bootstrap)
# stau in /etc/validez-be/compose.env, iar parola migratorului in /etc/validez-be/migrator.env
# (backend/deploy/*.sample). Deployul refuza sa ruleze daca aici apar DB_PASSWORD/POSTGRES_* sau
# daca DATABASE_URL nu foloseste validez_app.

# Rolul runtime (docs/postgresql-roles.md); parola setata cu \password validez_app, codificata in URL.
DATABASE_URL="postgresql://validez_app:schimba-aici@db:5432/validez?serverVersion=16&charset=utf8"

APP_ENV=prod
APP_DEBUG=0
# IP/CIDR exacte pentru nginx intern si nginx-proxy; nu folosi 0.0.0.0/0.
SYMFONY_TRUSTED_PROXIES=
APP_SECRET=schimba-aici
APP_SHARE_DIR=var/share
DEFAULT_URI=https://validez-be.webnou.ro
LOCK_DSN=flock

# JWT (lexik/jwt-authentication-bundle) - chei generate separat pe server, nu cele de pe dev
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=schimba-aici

# CORS - nelmio/cors-bundle. http://localhost = WebView-ul Cordova Android (preference Scheme=http).
CORS_ALLOW_ORIGIN=^(https://validez\.webnou\.ro|https?://localhost)$

# Adresa publica a FE (linkuri din emailuri: activare cont etc.)
FRONTEND_URL=https://validez.webnou.ro

MAILER_DSN=schimba-aici
MAILER_FROM_ADDRESS=info@webnou.ro

# ALTCHA cost and registration email sender (APP_SECRET derives separate HMAC keys).
ALTCHA_COST=1500

# Votarea (ADR-0007): rămâne false până la definitivarea textului privacy și rezolvarea punctelor deschise.
VOTING_ENABLED=false
