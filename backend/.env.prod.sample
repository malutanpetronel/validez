# Pe server: /var/www/validez-be/shared/backend/.env (symlink ansistrano langa docker-compose.prod.yml).
# E citit de docker compose (variabilele de mai jos) SI montat peste backend/.env in container,
# deci inlocuieste complet valorile implicite: toate cheile Symfony trebuie sa fie aici.

# Domeniul BE - de confirmat (FE: validez.webnou.ro)
VIRTUAL_HOST=validez-be.webnou.ro

# Numele proiectului compose. Implicit ar fi numele folderului ("backend"), comun cu alte monorepo-uri:
# compose ar trata containerele lor ca ale noastre (recreate/orphans). "name:" in compose nu merge pe 1.29.
COMPOSE_PROJECT_NAME=validez_be

DB_CONTAINER=validez_be_db
PHP_CONTAINER=validez_be_php
NGINX_CONTAINER=validez_be_nginx

# Imaginea construita local cu ./docker-build-push.sh (scriptul afiseaza linia exacta de pus aici)
DOCKER_IMAGE=malutanpetronel/api:validez_be_AAAAMMZZ_HHMM

DB_NAME=validez
DB_USER=validez
DB_PASSWORD=schimba-aici
# DATABASE_URL e construit in docker-compose.prod.yml din valorile de mai sus.

APP_ENV=prod
APP_DEBUG=0
# IP/CIDR exacte pentru nginx intern si nginx-proxy; nu folosi 0.0.0.0/0.
SYMFONY_TRUSTED_PROXIES=
APP_SECRET=schimba-aici
APP_SHARE_DIR=var/share
DEFAULT_URI=https://validez-be.webnou.ro
LOCK_DSN=flock

# JWT (lexik/jwt-authentication-bundle) - chei generate separat pe server, nu cele de pe dev
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=schimba-aici

# CORS - nelmio/cors-bundle. http://localhost = WebView-ul Cordova Android (preference Scheme=http).
CORS_ALLOW_ORIGIN=^(https://validez\.webnou\.ro|http://localhost)$

# Adresa publica a FE (linkuri din emailuri: activare cont etc.)
FRONTEND_URL=https://validez.webnou.ro

MAILER_DSN=schimba-aici
MAILER_FROM_ADDRESS=info@webnou.ro

# ALTCHA cost and registration email sender (APP_SECRET derives separate HMAC keys).
ALTCHA_COST=1500
