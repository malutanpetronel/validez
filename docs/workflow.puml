@startuml workflow
title Validez - Workflow utilizator

start

:Deschide aplicația;
:Navighează arborele (TreeNode)\n(fără cont necesar);

:Deschide o categorie;

if (Creează o sesizare?) then (da)
  :Autentificare și creare CivicSubject ISSUE;
  :Adaugă descriere, fotografii,\nvideoclipuri și localizare GPS;
  :Regulile de competență propun\ninstituții bifate din registrul unic;
  :Utilizatorul poate debifa\nsau adăuga alte instituții;
  :Salvează selecția și modul de trimitere;\nrespectă moderarea ADR-0006;
endif

:Vede până la 5 CivicSubject ca frunze\nasociate direct categoriei;

if (Vrea lista completă?) then (da)
  :Vezi tot (N subiecte)\nlistă cu filtre, 20/pagină;
  :Înapoi la arbore reface categoria\nselectată și ramurile deschise;
endif

if (Selectează un CivicSubject?) then (da)

  :Vizualizează CivicSubject;
  :Media, descriere, locație,\nautorități asociate,\nstatus și rezultate;

  if (Vrea să voteze?) then (da)

    if (Este autentificat?) then (nu)
      :Login
      (email/parolă, Google,\nFacebook, Apple);
    endif

    :Vede tipurile de vot active\n(SubjectVoteType);

    if (Are deja un vot pentru\n(subject, vote_type)?) then (da)
      :Alege noua valoare;
    else (nu)
      :Alege tipul și valoarea votului;
    endif

    :Device semnează payload-ul\ncu cheia privată;

    :Backend validează semnătura;

    :Creează VoteEvent\n(previous_hash -> hash);

    :Actualizează Vote curent;

    :Recalculează VoteAggregate /\nVoteResult pentru\n(subject, vote_type);

    :Recalculează scorul de Prioritate\n(nu se votează direct);

  endif

  if (Vrea să comenteze?) then (da)

    if (Este autentificat?) then (nu)
      :Login;
    endif

    :Adaugă Comment;
    :Opțional parent_id\n(pentru răspuns);
    
  endif

  if (Vrea să raporteze conținutul?) then (da)

    if (Este autentificat?) then (nu)
      :Login;
    endif

    :Creează Flag;
    :Flag intră în coada de moderare;

  endif

  :Afișează rezultatele actualizate\nper tip de vot;
  :Afișează statusul și istoricul\nrelevant al CivicSubject;

  if (Sesizare publicată către autorități?) then (da)
    :Verifică destinatarii și politica de praguri\npe voturile active, media și GPS;
    if (Trimitere manuală eligibilă sau\npraguri automate îndeplinite?) then (da)
      :Propune trimiterea / utilizatorul apasă\nTrimite sesizarea / mod automat activat explicit;
      :La declanșare: reverifică eligibilitatea\nși evită depunerile duplicate;
      :Generează document și pachet fixat\ncu media, GPS, voturi și validări;
      :Trimite prin canalele integrate\nsau oferă document pentru depunere manuală;
      :Număr intern unic și urmărire per instituție;\nTrimisă -> Înregistrată -> În analiză\n-> Rezolvată / Respinsă;
      :Asociază și publică răspunsurile\ncu protejarea datelor personale;
      :Comunitatea poate confirma sau contesta\nrezolvarea efectivă;
    else (nu)
      :Afișează condițiile încă neîndeplinite;
    endif
  endif

else (nu)

  :Continuă navigarea;

endif

:Poate căuta/filtra după:
categorie, localitate, județ,
tip subiect, popularitate,\ndistanță;

stop

@enduml
