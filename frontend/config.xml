<?xml version='1.0' encoding='utf-8'?>
<widget id="ro.webnou.validez" version="0.1.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>VALIDEZ</name>
    <description>Vezi. Verifică. Validează.</description>
    <author email="info@webnou.ro" href="https://validez.webnou.ro">
        Validez contributors
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="android-minSdkVersion" value="23" />
    <!-- Scheme http -> origin http://localhost in WebView (inclus in CORS_ALLOW_ORIGIN pe BE) -->
    <preference name="Scheme" value="http" />
    <!-- Ecran de pornire (Android 12+ SplashScreen API, cordova-android 12): sigla rotundă pe fundal alb.
         splash-icon.png = assets/sigla rotunda loading transparenta.png, decupată și redusă la 720 px pe o pânză
         de 1152 px (288 dp xxxhdpi), ca cercul de 2/3 decupat de Android să nu taie marginile siglei. -->
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/screen/android/splash-icon.png" />
    <preference name="AndroidWindowSplashScreenBackground" value="#FFFFFF" />
    <!-- Ascuns din JS imediat după prima randare (src/index.js); 3 s = plasa de siguranță dacă JS-ul eșuează. -->
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="SplashScreenDelay" value="3000" />
    <preference name="FadeSplashScreenDuration" value="300" />
    <platform name="android">
        <icon src="res/icon/android/mdpi.png" density="mdpi" />
        <icon src="res/icon/android/hdpi.png" density="hdpi" />
        <icon src="res/icon/android/xhdpi.png" density="xhdpi" />
        <icon src="res/icon/android/xxhdpi.png" density="xxhdpi" />
        <icon src="res/icon/android/xxxhdpi.png" density="xxxhdpi" />
        <icon density="mdpi" background="res/icon/android/bg.png" foreground="res/icon/android/fg-mdpi.png" />
        <icon density="hdpi" background="res/icon/android/bg.png" foreground="res/icon/android/fg-hdpi.png" />
        <icon density="xhdpi" background="res/icon/android/bg.png" foreground="res/icon/android/fg-xhdpi.png" />
        <icon density="xxhdpi" background="res/icon/android/bg.png" foreground="res/icon/android/fg-xxhdpi.png" />
        <icon density="xxxhdpi" background="res/icon/android/bg.png" foreground="res/icon/android/fg-xxxhdpi.png" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>
    </platform>
</widget>
