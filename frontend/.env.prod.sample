# Pe server: /var/www/validez-fe/shared/frontend/.env (symlink ansistrano langa docker-compose.prod.yml).
VIRTUAL_HOST=validez.webnou.ro
# Numele proiectului compose (implicit ar fi "frontend", comun cu alte monorepo-uri)
COMPOSE_PROJECT_NAME=validez_fe
WEB_CONTAINER=validez_fe_web

# Imaginea construita local cu ./docker-build-push.sh (scriptul afiseaza linia exacta de pus aici)
DOCKER_IMAGE=malutanpetronel/api:validez_fe_AAAAMMZZ_HHMM
